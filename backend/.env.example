# Copy to .env for local runs. Never commit real secrets.
SUPABASE_URL=
SUPABASE_KEY=

# Security tunables (optional)
# TRUST_CLOUDFLARE_HEADERS=true
# ENABLE_DEBUG_ROUTES=false
# CHAT_RATE_LIMIT_PER_MINUTE=20
# GLOBAL_CHAT_RATE_LIMIT_PER_MINUTE=60
# TRANSCRIBE_RATE_LIMIT_PER_MINUTE=10
# GLOBAL_TRANSCRIBE_RATE_LIMIT_PER_MINUTE=30
# MAX_CONCURRENT_AI_REQUESTS=2
# MAX_CONCURRENT_TRANSCRIBE_REQUESTS=1
# MAX_CHAT_BODY_BYTES=32768

# Private five-book editorial preview (off by default)
# ENABLE_EDITORIAL_PREVIEW=false
# CMS JWT auth (preferred): verify Supabase access tokens + profiles.role
# SUPABASE_JWT_SECRET=
# SUPABASE_JWT_AUD=authenticated
# SUPABASE_JWT_ISS=   # defaults to {SUPABASE_URL}/auth/v1
# EDITORIAL_CONFIRM_AUTH_API=false
# Legacy shared-secret fallback (disabled by default; ops break-glass only)
# EDITORIAL_ALLOW_LEGACY_TOKEN=false
# EDITORIAL_PREVIEW_TOKEN=
# Keep the unapproved five-book package OUTSIDE the monorepo (private eval only).
# If unset, the backend may discover a sibling ../tewahedo-ai/content-review for
# local evaluation only — it is never copied into this repo or into Pages builds.
# CONTENT_REVIEW_ROOT=C:\Users\eskew\github\tewahedo-ai\content-review
# CONTENT_REVIEW_ZIP=C:\Users\eskew\github\tewahedo-ai\content-review.zip
# EDITORIAL_APPROVAL_STORE=
