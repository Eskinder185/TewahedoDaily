# Browser-safe values from the Supabase project's Connect dialog.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_browser_safe_anon_or_publishable_key
VITE_TURNSTILE_SITE_KEY=your_public_turnstile_site_key
# Optional rollout switch: legacy keeps the old public JSON/catalog experience.
# Once the CMS migration/import is verified, remove this or set to supabase.
VITE_PUBLIC_MEZMUR_SOURCE=supabase
# VITE_SUPABASE_PUBLISHABLE_KEY remains supported for existing deployments.

# Only used by `npm run supabase:import-chants` on your machine/CI.
# Never prefix this value with VITE_ or expose it in frontend hosting settings.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_me

