# Browser-safe values from the Supabase project API settings / Connect dialog.
# These are embedded at Vite build time (Cloudflare Pages → Settings → Environment variables).
VITE_SUPABASE_URL=https://tgvhpibzzkqxkcumrivh.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional: Cloudflare Turnstile public site key (spam challenge on community forms).
# Submissions work without this when Supabase is configured; the challenge is shown when set.
VITE_TURNSTILE_SITE_KEY=

# Optional rollout switch: legacy keeps the old public JSON/catalog experience.
# VITE_PUBLIC_MEZMUR_SOURCE is no longer used. When VITE_SUPABASE_* is set,
# /practice always loads published rows from public.mezmur (not local JSON).

# --- Server-only (never prefix with VITE_; never add to Cloudflare "Build" vars that ship to the browser) ---
# Used by Cloudflare Pages Function POST /api/submissions and local import scripts.
# SUPABASE_URL=https://tgvhpibzzkqxkcumrivh.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# TURNSTILE_SECRET_KEY=
# SUBMISSION_IP_HASH_SECRET=
# SITE_URL=https://tewahedodaily.pages.dev
