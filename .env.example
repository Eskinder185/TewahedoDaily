# Browser-safe values from the Supabase project API settings / Connect dialog.
# These are embedded at Vite build time (Cloudflare Pages → Settings → Environment variables).
VITE_SUPABASE_URL=https://tgvhpibzzkqxkcumrivh.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional: Cloudflare Turnstile public site key (spam challenge on community forms).
# Submissions work without this when Supabase is configured; the challenge is shown when set.
VITE_TURNSTILE_SITE_KEY=

# Optional responsive image transforms for Mezmur/hymn Storage URLs (off by default).
# Supabase Image Transformations and Cloudflare Image Resizing are both unavailable
# on the current project (403 / 404). Leave unset until ops enables one of them.
# VITE_IMAGE_RESIZE_MODE=supabase
# VITE_IMAGE_RESIZE_MODE=cloudflare

# Optional public AI / Search Buddy API (homelab-backed FastAPI).
# Local development example (.env.local only — never commit LAN IPs):
#   VITE_TEWAHEDO_AI_API_URL=https://ai.eskinder.dev
# Production: public HTTPS gateway only (LAN/localhost URLs are ignored in PROD builds).
# Example: https://ai.tewahedodaily.com
# VITE_TEWAHEDO_AI_API_URL=https://ai.eskinder.dev
# Optional toggles (defaults: chat on when URL set; server transcription/OCR off):
# VITE_AI_CHAT_ENABLED=true
# Optional: legacy flag for older transcription helpers (Amharic Search Buddy voice uses
# VITE_TEWAHEDO_AI_API_URL directly via POST /api/transcribe).
# VITE_AI_SERVER_TRANSCRIPTION_ENABLED=false
# VITE_AI_OCR_ENABLED=false
# Never put API secrets, service-role keys, Ollama (11434), Docker internals, or private tokens in VITE_* vars.

# Optional rollout switch: legacy keeps the old public JSON/catalog experience.
# VITE_PUBLIC_MEZMUR_SOURCE is no longer used. When VITE_SUPABASE_* is set,
# /practice always loads published rows from public.mezmur (not local JSON).

# --- Server-only (never prefix with VITE_; never add to Cloudflare "Build" vars that ship to the browser) ---
# Used by Cloudflare Pages Function POST /api/submissions and local import scripts.
# SUPABASE_URL=https://tgvhpibzzkqxkcumrivh.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# TURNSTILE_SECRET_KEY=
# SUBMISSION_IP_HASH_SECRET=
# SITE_URL=https://tewahedodaily.pages.dev
