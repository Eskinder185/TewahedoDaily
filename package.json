{
  "name": "tewahedo-daily",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "supabase:plan-mezmur": "node scripts/import-mezmur-cms.mjs --dry-run",
    "supabase:import-mezmur": "node --env-file-if-exists=.env.local scripts/import-mezmur-cms.mjs",
    "import:chants": "node --env-file-if-exists=.env.import --env-file-if-exists=.env.local scripts/import-chants-to-supabase/index.mjs",
    "test:public": "node scripts/test-mezmur-import.mjs && node scripts/public-discovery-smoke.mjs",
    "lint:public": "eslint src/lib/publicContent src/components/publicContent src/pages/Public*.tsx",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "lint:cms": "eslint src/pages/admin src/lib/cms src/lib/auth src/lib/supabase src/App.tsx src/main.tsx",
    "test:cms:auth": "node scripts/cms-auth-smoke.mjs",
    "test:cms:admin": "node scripts/cms-admin-smoke.mjs",
    "preview": "vite preview",
    "smoke:mobile": "node scripts/mobile-smoke.mjs",
    "normalize:english-chants": "npx --yes tsx scripts/normalize-english-chants.ts",
    "normalize:amharic-chants": "node scripts/normalize-amharic-chants.mjs",
    "normalize:werb": "node scripts/normalize-chant-json.mjs",
    "dedupe:amharic-chants": "node scripts/dedupe-amharic-chants.mjs",
    "merge:amharic-chant-append": "node scripts/merge-amharic-chant-append.mjs",
    "supabase:import-chants": "node --env-file-if-exists=.env.local scripts/import-chants-to-supabase.mjs",
    "supabase:check-data": "node scripts/import-chants-to-supabase.mjs --dry-run",
    "supabase:plan-prayers": "node scripts/import-prayers.mjs --dry-run",
    "supabase:import-prayers": "node scripts/import-prayers.mjs --apply",
    "supabase:plan-prayer-guides": "node --env-file-if-exists=.env.local scripts/import-prayer-guides.mjs --dry-run",
    "supabase:import-prayer-guides": "node --env-file-if-exists=.env.local scripts/import-prayer-guides.mjs --apply",
    "lint:community": "eslint functions src/lib/community src/components/community src/pages/CommunityForm.tsx",
    "test:community": "node scripts/community-api-test.mjs && node scripts/community-browser-test.mjs",
    "test:platform": "node scripts/content-platform-smoke.mjs",
    "test:calendar-cards": "node scripts/test-calendar-card-reconciliation.mjs",
    "test:hymn-browse": "node scripts/test-hymn-browse.mjs",
    "test:synaxarium-presentation": "node --experimental-strip-types scripts/test-synaxarium-presentation.mjs",
    "optimize:calendar-images": "node scripts/optimize-calendar-images.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.114.0",
    "fuse.js": "^7.3.0",
    "playwright": "^1.49.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.14.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "sharp": "^0.35.5",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.4"
  }
}
